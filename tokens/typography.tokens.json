{
  "$collection": "Typography",
  "$modes": ["Mode 1"],
  "FontFamily": {
    "Display": {
      "$type": "string",
      "$value": "Fraunces, Georgia, serif",
      "$description": "Dramatic variable serif for hero / poster headlines"
    },
    "Sans": {
      "$type": "string",
      "$value": "Pretendard, Inter, system-ui, sans-serif",
      "$description": "Clean UI & body text — Pretendard covers Korean beautifully"
    },
    "Mono": {
      "$type": "string",
      "$value": "JetBrains Mono, Fira Code, monospace",
      "$description": "Code & technical details"
    },
    "Condensed": {
      "$type": "string",
      "$value": "Barlow Condensed, Arial Narrow, sans-serif",
      "$description": "Tight, dramatic type for poster-style labels and tags"
    }
  },
  "FontSize": {
    "2xs": { "$type": "number", "$value": 10 },
    "xs":  { "$type": "number", "$value": 11 },
    "sm":  { "$type": "number", "$value": 13 },
    "base":{ "$type": "number", "$value": 16 },
    "md":  { "$type": "number", "$value": 18 },
    "lg":  { "$type": "number", "$value": 20 },
    "xl":  { "$type": "number", "$value": 24 },
    "2xl": { "$type": "number", "$value": 30 },
    "3xl": { "$type": "number", "$value": 36 },
    "4xl": { "$type": "number", "$value": 48 },
    "5xl": { "$type": "number", "$value": 64 },
    "6xl": { "$type": "number", "$value": 80 },
    "7xl": { "$type": "number", "$value": 96 },
    "display": { "$type": "number", "$value": 128 },
    "poster":  { "$type": "number", "$value": 160 }
  },
  "FontWeight": {
    "light":     { "$type": "number", "$value": 300 },
    "regular":   { "$type": "number", "$value": 400 },
    "medium":    { "$type": "number", "$value": 500 },
    "semibold":  { "$type": "number", "$value": 600 },
    "bold":      { "$type": "number", "$value": 700 },
    "extrabold": { "$type": "number", "$value": 800 },
    "black":     { "$type": "number", "$value": 900 }
  },
  "LineHeight": {
    "none":    { "$type": "number", "$value": 1 },
    "tight":   { "$type": "number", "$value": 1.1 },
    "snug":    { "$type": "number", "$value": 1.25 },
    "normal":  { "$type": "number", "$value": 1.5 },
    "relaxed": { "$type": "number", "$value": 1.75 },
    "loose":   { "$type": "number", "$value": 2 }
  },
  "LetterSpacing": {
    "tightest": { "$type": "number", "$value": -0.05 },
    "tighter":  { "$type": "number", "$value": -0.03 },
    "tight":    { "$type": "number", "$value": -0.02 },
    "normal":   { "$type": "number", "$value": 0 },
    "wide":     { "$type": "number", "$value": 0.05 },
    "wider":    { "$type": "number", "$value": 0.1 },
    "widest":   { "$type": "number", "$value": 0.25 },
    "poster":   { "$type": "number", "$value": 0.4, "$description": "Extreme tracking for poster-style uppercase labels" }
  }
}
